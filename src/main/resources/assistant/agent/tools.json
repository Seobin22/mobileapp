[
  {
    "name": "get_timeline",
    "description": "기간(최대 14일)의 시간표를 날짜별로 본다. items 의 kind 는 fixed_block(사용자가 시각을 정한 고정 블록)·planned_block(네가 잡은 계획 블록)·quiet(방해 금지)·meal(식사)·free(빈 시간). 블록마다 goal_id·goal_label·goal_color. 고정 블록은 lead_minutes(출발·준비)·buffer_after_min(끝난 뒤 이동) 구간도 다른 블록 금지. 시각은 ISO-8601(오프셋 포함).",
    "input_schema": {
      "type": "object",
      "properties": {
        "from": {
          "type": "string",
          "description": "시작 시각 ISO-8601"
        },
        "to": {
          "type": "string",
          "description": "끝 시각 ISO-8601"
        }
      },
      "required": [
        "from",
        "to"
      ]
    }
  },
  {
    "name": "get_history",
    "description": "과거 기록을 본다. completions=블록 결과(완료·놓침 등), interventions=개입 기록, messages=대화.",
    "input_schema": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "completions",
            "interventions",
            "messages"
          ]
        },
        "since": {
          "type": "string",
          "description": "이 시각 이후 ISO-8601"
        },
        "task_id": {
          "type": "integer"
        },
        "limit": {
          "type": "integer",
          "description": "기본 50"
        }
      },
      "required": [
        "kind",
        "since"
      ]
    }
  },
  {
    "name": "get_load_summary",
    "description": "목표별(+목표 없는 할 일) 남은 작업 시간과 마감까지 빈 시간을 비교한 부하 요약. status 는 ok·tight·short·no_deadline.",
    "input_schema": {
      "type": "object",
      "properties": {}
    }
  },
  {
    "name": "get_goal_coverage",
    "description": "활성 목표마다 다음 블록 시각과 상태(ok·missing(앞으로 며칠 안에 블록 없음)·waiting(기다리는 중))를 본다.",
    "input_schema": {
      "type": "object",
      "properties": {}
    }
  },
  {
    "name": "upsert_goal",
    "description": "목표를 만들거나 고친다. id 가 없으면 생성(title 필수). 만들 때 label(6자 이내 이름표)·strategy·strategy_summary(목표 탭용 1~2줄)를 함께 정한다. color 는 코드가 정한다. 마감·상태 변경은 사용자가 직접 말한 경우가 아니면 확인 카드가 된다. 외부 결과를 기다리는 중이면 waiting_until(다음 확인 시각)·waiting_reason 을 적는다(그 시각에 goal_waiting_check 로 깨어난다).",
    "input_schema": {
      "type": "object",
      "properties": {
        "id": {
          "type": "integer"
        },
        "title": {
          "type": "string"
        },
        "deadline": {
          "type": [
            "string",
            "null"
          ],
          "description": "ISO-8601 또는 null(마감 없음)"
        },
        "reason": {
          "type": "string",
          "description": "사용자가 이 목표를 이루고 싶은 이유"
        },
        "strategy": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": [
            "active",
            "done"
          ]
        },
        "sensitive": {
          "type": "boolean"
        },
        "label": {
          "type": "string",
          "description": "짧은 이름표(6자 이내). 예: 컴활, 쇼핑몰"
        },
        "strategy_summary": {
          "type": "string",
          "description": "목표 탭에 보일 전략 요약 1~2줄"
        },
        "progress": {
          "type": [
            "object",
            "null"
          ],
          "description": "진행 측정. 예: {\"unit\":\"챕터\",\"total\":12,\"done\":5}",
          "properties": {
            "unit": {
              "type": "string"
            },
            "total": {
              "type": "number"
            },
            "done": {
              "type": "number"
            }
          }
        },
        "waiting_until": {
          "type": [
            "string",
            "null"
          ],
          "description": "기다리는 중이면 다음 확인 시각 ISO-8601, 끝나면 null"
        },
        "waiting_reason": {
          "type": [
            "string",
            "null"
          ],
          "description": "무엇을 기다리는지"
        },
        "priority": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "confirm_text": {
          "type": "string",
          "description": "확인 카드가 될 때 사용자에게 보일 이유 한 문장"
        }
      }
    }
  },
  {
    "name": "upsert_task",
    "description": "할 일을 만들거나 고친다. 생성 시 title·est_minutes·first_action 필수. remaining_minutes 를 생략하면 est_minutes. status=done 이면 미래 블록이 취소되고 남은 시간이 0 이 된다.",
    "input_schema": {
      "type": "object",
      "properties": {
        "id": {
          "type": "integer"
        },
        "goal_id": {
          "type": [
            "integer",
            "null"
          ]
        },
        "title": {
          "type": "string"
        },
        "deadline": {
          "type": [
            "string",
            "null"
          ]
        },
        "est_minutes": {
          "type": "integer"
        },
        "remaining_minutes": {
          "type": "integer"
        },
        "priority": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "first_action": {
          "type": "string",
          "description": "바로 시작할 수 있을 만큼 작은 첫 행동"
        },
        "notes": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": [
            "active",
            "done"
          ]
        },
        "sensitive": {
          "type": "boolean"
        }
      }
    }
  },
  {
    "name": "upsert_fixed_block",
    "description": "고정 블록을 만들거나 고친다. 사용자가 시각을 정해 잡아달라고 한 것(약속이든 공부든 \"몇 시에 ○○ 잡아줘\")은 무조건 이것으로 만든다. 생성 시 title·start·end 필수. lead_minutes 는 출발·준비 시간(개입이 start − lead 에 시작, 생략하면 기본값), buffer_after_min 은 끝난 뒤 이동·회복 시간. 관련 목표가 있으면 goal_id 를 연결한다. 고정 블록끼리 겹치면 거절되니 사용자에게 다시 묻는다. 계획 블록과 겹치면 고정 블록이 만들어지고 겹친 계획 블록은 displaced 로 취소되니 다시 배치한다. 사용자가 방금 말한 경우가 아니면 확인 카드가 된다.",
    "input_schema": {
      "type": "object",
      "properties": {
        "id": {
          "type": "integer"
        },
        "title": {
          "type": "string"
        },
        "start": {
          "type": "string",
          "description": "ISO-8601"
        },
        "end": {
          "type": "string",
          "description": "ISO-8601"
        },
        "lead_minutes": {
          "type": "integer",
          "description": "출발·준비 시간(분). 외출 약속은 이동 시간에 맞게, 집에서 하는 일은 0~5"
        },
        "buffer_after_min": {
          "type": "integer",
          "description": "끝난 뒤 이동·회복 시간(분)"
        },
        "location": {
          "type": "string"
        },
        "goal_id": {
          "type": [
            "integer",
            "null"
          ]
        },
        "task_id": {
          "type": [
            "integer",
            "null"
          ]
        },
        "screen_text": {
          "type": "string",
          "description": "시작 화면 한 문장. 비우면 '곧 {title}이에요...'"
        },
        "sensitive": {
          "type": "boolean"
        },
        "confirm_text": {
          "type": "string",
          "description": "확인 카드가 될 때 사용자에게 보일 이유 한 문장"
        }
      }
    }
  },
  {
    "name": "upsert_note",
    "description": "실행 약속이 없는 막연한 생각을 메모로 저장하거나 상태를 바꾼다.",
    "input_schema": {
      "type": "object",
      "properties": {
        "id": {
          "type": "integer"
        },
        "content": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": [
            "open",
            "converted",
            "dismissed"
          ]
        }
      }
    }
  },
  {
    "name": "cancel",
    "description": "목표·할 일·고정 블록·메모를 취소한다. 할 일·목표를 취소하면 연결된 미래 계획 블록도 취소된다. 목표를 취소해도 연결된 고정 블록은 남고 목표 연결만 풀린다.",
    "input_schema": {
      "type": "object",
      "properties": {
        "entity": {
          "type": "string",
          "enum": [
            "goal",
            "task",
            "fixed_block",
            "note"
          ]
        },
        "id": {
          "type": "integer"
        },
        "confirm_text": {
          "type": "string",
          "description": "확인 카드가 될 때 사용자에게 보일 이유 한 문장"
        }
      },
      "required": [
        "entity",
        "id"
      ]
    }
  },
  {
    "name": "save_memory",
    "description": "사용자에 대한 지속적인 사실을 정리한 memory 전체를 교체한다. 기존 내용을 유지하면서 고쳐 쓴다.",
    "input_schema": {
      "type": "object",
      "properties": {
        "content": {
          "type": "string"
        }
      },
      "required": [
        "content"
      ]
    }
  },
  {
    "name": "undo_last",
    "description": "사용자의 직전 요청으로 바뀐 것을 되돌린다(\"방금 거 취소\").",
    "input_schema": {
      "type": "object",
      "properties": {}
    }
  },
  {
    "name": "set_schedule",
    "description": "[from, to) 구간에서 시작하는 계획(planned) 블록을 모두 이 blocks 로 바꾼다. 고정 블록은 건드리지 않으며 그대로 유지된다(고정 블록은 upsert_fixed_block). blocks 항목에는 task_id 가 필요하고 목표는 할 일에서 자동으로 채운다. 검증에 실패하면 violations 를 돌려주고 아무것도 바꾸지 않는다.",
    "input_schema": {
      "type": "object",
      "properties": {
        "from": {
          "type": "string"
        },
        "to": {
          "type": "string"
        },
        "blocks": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "task_id": {
                "type": "integer"
              },
              "start": {
                "type": "string"
              },
              "end": {
                "type": "string"
              },
              "screen_text": {
                "type": "string",
                "description": "시작 화면 한 문장. 비우면 '지금 할 건 하나예요. {first_action}'"
              }
            },
            "required": [
              "task_id",
              "start",
              "end"
            ]
          }
        }
      },
      "required": [
        "from",
        "to",
        "blocks"
      ]
    }
  },
  {
    "name": "move_block",
    "description": "planned 또는 nudging 블록 하나를 옮긴다. new_end 를 생략하면 길이를 유지한다. 계획 블록은 자유롭게, 고정 블록은 사용자가 방금 말한 경우가 아니면 확인 카드가 된다. 진행 중 개입(시작 화면)의 블록을 옮기면 미룸(snoozed)으로 끝나고 새 시각에 다시 뜬다.",
    "input_schema": {
      "type": "object",
      "properties": {
        "block_id": {
          "type": "integer"
        },
        "new_start": {
          "type": "string"
        },
        "new_end": {
          "type": "string"
        },
        "confirm_text": {
          "type": "string",
          "description": "확인 카드가 될 때 사용자에게 보일 이유 한 문장"
        }
      },
      "required": [
        "block_id",
        "new_start"
      ]
    }
  },
  {
    "name": "send_message",
    "description": "사용자에게 메시지를 보낸다. 사용자 메시지에 대한 답은 kind=reply. 먼저 말 걸 때는 proactive, 아침·저녁 정리는 briefing, 작업 중 진행 확인은 checkin. 알림을 울릴지(silent)는 코드가 정하고 결과로 알려준다(방해 금지·일정·작업 중·하루 예산 초과면 알림 없이 채팅에만 쌓인다). 정말 중요한 것만 importance=high.",
    "input_schema": {
      "type": "object",
      "properties": {
        "text": {
          "type": "string"
        },
        "kind": {
          "type": "string",
          "enum": [
            "reply",
            "proactive",
            "briefing",
            "checkin"
          ]
        },
        "importance": {
          "type": "string",
          "enum": [
            "low",
            "normal",
            "high"
          ]
        }
      },
      "required": [
        "text"
      ]
    }
  },
  {
    "name": "ask_user",
    "description": "답이 필요한 것을 묻는다. 가능하면 선택지 버튼(최대 4개)을 준다.",
    "input_schema": {
      "type": "object",
      "properties": {
        "text": {
          "type": "string"
        },
        "options": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "maxItems": 4
        }
      },
      "required": [
        "text"
      ]
    }
  },
  {
    "name": "get_facts",
    "description": "할 일 하나의 사실만 계산한다(판단 없음): 오늘 미룬 횟수·분, 마감까지 남은 시간, 남은 작업 분, 마감까지 빈 시간, 여유(slack), 30분 미루면 여유, 이 시간대 최근 7일 시작률, 이유. 미루기 협상·체크인의 근거로 쓴다.",
    "input_schema": {
      "type": "object",
      "properties": {
        "task_id": {
          "type": "integer"
        }
      },
      "required": [
        "task_id"
      ]
    }
  },
  {
    "name": "start_now",
    "description": "지금 바로 시작한다. block_id 를 주면 그 블록의 진행 중 개입(시작 화면, 고정 블록 포함)을 시작 처리한다. task_id 를 주면: 진행 중 개입이 이 할 일 블록이면 그 블록을 시작 처리하고, 아니면 지금부터 블록을 만들어 바로 started 로 둔다(길이 = 남은 시간과 다음 블록 길이(없으면 60분) 중 작은 값). 겹친 planned 블록은 취소되고 displaced 로 알려주니 다시 배치한다. 고정 블록·방해 금지와 겹치면 거절.",
    "input_schema": {
      "type": "object",
      "properties": {
        "task_id": {
          "type": "integer"
        },
        "block_id": {
          "type": "integer"
        }
      }
    }
  },
  {
    "name": "extend_block",
    "description": "진행 중(started) 블록의 끝 시각을 늘린다. 뒤 블록·일정·식사·방해 금지와 겹치면 거절되니, 뒤 블록이 있으면 move_block 으로 먼저 옮긴다.",
    "input_schema": {
      "type": "object",
      "properties": {
        "block_id": {
          "type": "integer"
        },
        "new_end": {
          "type": "string",
          "description": "ISO-8601"
        }
      },
      "required": [
        "block_id",
        "new_end"
      ]
    }
  },
  {
    "name": "end_block",
    "description": "진행 중(started) 블록을 끝낸다. outcome=done(이번 블록 분량 완료) 또는 partial. remaining_minutes 를 주면 할 일의 남은 시간을 갱신한다. 할 일 자체를 완료하려면 upsert_task(status=done)를 따로 호출한다.",
    "input_schema": {
      "type": "object",
      "properties": {
        "block_id": {
          "type": "integer"
        },
        "outcome": {
          "type": "string",
          "enum": [
            "done",
            "partial"
          ]
        },
        "remaining_minutes": {
          "type": "integer"
        }
      },
      "required": [
        "block_id",
        "outcome"
      ]
    }
  },
  {
    "name": "schedule_wakeup",
    "description": "정한 시각에 다시 깨어나 판단하도록 예약한다(체크인·사전 브리핑·결과 확인 등). at 은 미래. task_id 를 주면 그 할 일이 끝나거나 취소됐을 때 건너뛴다. 할 일당 예약 개수 상한이 있다.",
    "input_schema": {
      "type": "object",
      "properties": {
        "at": {
          "type": "string",
          "description": "ISO-8601"
        },
        "reason": {
          "type": "string",
          "description": "깨어났을 때 할 일(예: 30분 체크인, 사전 브리핑)"
        },
        "task_id": {
          "type": "integer"
        }
      },
      "required": [
        "at",
        "reason"
      ]
    }
  },
  {
    "name": "cancel_wakeup",
    "description": "예약한 wakeup 을 취소한다.",
    "input_schema": {
      "type": "object",
      "properties": {
        "id": {
          "type": "integer"
        }
      },
      "required": [
        "id"
      ]
    }
  },
  {
    "name": "create_work_product",
    "description": "할 일에 도움이 되는 작업물(조사 요약·체크리스트·초안·공부 범위)을 마크다운으로 저장한다. 웹에서 찾은 내용은 sources 에 출처를 넣고, 확실하지 않으면 본문에 '확인 필요'라고 적는다. 결과 id 를 attach_work_product 로 블록에 붙인다.",
    "input_schema": {
      "type": "object",
      "properties": {
        "task_id": {
          "type": "integer"
        },
        "title": {
          "type": "string"
        },
        "kind": {
          "type": "string",
          "enum": [
            "checklist",
            "research",
            "draft",
            "study_plan",
            "other"
          ]
        },
        "content_md": {
          "type": "string"
