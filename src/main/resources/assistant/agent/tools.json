[
  {
    "name": "get_timeline",
    "description": "기간(최대 14일)의 시간표를 날짜별로 본다. items 의 kind 는 event(고정 일정)·block(작업 배치)·quiet(방해 금지)·meal(식사)·free(빈 시간). 시각은 ISO-8601(오프셋 포함).",
    "input_schema": {
      "type": "object",
      "properties": {
        "from": {"type": "string", "description": "시작 시각 ISO-8601"},
        "to": {"type": "string", "description": "끝 시각 ISO-8601"}
      },
      "required": ["from", "to"]
    }
  },
  {
    "name": "get_history",
    "description": "과거 기록을 본다. completions=블록 결과(완료·놓침 등), interventions=개입 기록, messages=대화.",
    "input_schema": {
      "type": "object",
      "properties": {
        "kind": {"type": "string", "enum": ["completions", "interventions", "messages"]},
        "since": {"type": "string", "description": "이 시각 이후 ISO-8601"},
        "task_id": {"type": "integer"},
        "limit": {"type": "integer", "description": "기본 50"}
      },
      "required": ["kind", "since"]
    }
  },
  {
    "name": "get_load_summary",
    "description": "목표별(+목표 없는 할 일) 남은 작업 시간과 마감까지 빈 시간을 비교한 부하 요약. status 는 ok·tight·short·no_deadline.",
    "input_schema": {"type": "object", "properties": {}}
  },
  {
    "name": "upsert_goal",
    "description": "목표를 만들거나 고친다. id 가 없으면 생성(title 필수). 마감·상태 변경은 사용자가 직접 말한 경우가 아니면 확인 카드가 된다.",
    "input_schema": {
      "type": "object",
      "properties": {
        "id": {"type": "integer"},
        "title": {"type": "string"},
        "deadline": {"type": ["string", "null"], "description": "ISO-8601 또는 null(마감 없음)"},
        "reason": {"type": "string", "description": "사용자가 이 목표를 이루고 싶은 이유"},
        "strategy": {"type": "string"},
        "status": {"type": "string", "enum": ["active", "done"]},
        "sensitive": {"type": "boolean"},
        "confirm_text": {"type": "string", "description": "확인 카드가 될 때 사용자에게 보일 이유 한 문장"}
      }
    }
  },
  {
    "name": "upsert_task",
    "description": "할 일을 만들거나 고친다. 생성 시 title·est_minutes·first_action 필수. remaining_minutes 를 생략하면 est_minutes. status=done 이면 미래 블록이 취소되고 남은 시간이 0 이 된다.",
    "input_schema": {
      "type": "object",
      "properties": {
        "id": {"type": "integer"},
        "goal_id": {"type": ["integer", "null"]},
        "title": {"type": "string"},
        "deadline": {"type": ["string", "null"]},
        "est_minutes": {"type": "integer"},
        "remaining_minutes": {"type": "integer"},
        "priority": {"type": "integer", "minimum": 1, "maximum": 5},
        "first_action": {"type": "string", "description": "바로 시작할 수 있을 만큼 작은 첫 행동"},
        "notes": {"type": "string"},
        "status": {"type": "string", "enum": ["active", "done"]},
        "sensitive": {"type": "boolean"}
      }
    }
  },
  {
    "name": "upsert_event",
    "description": "고정 일정을 만들거나 고친다. 생성 시 title·start·end 필수. 앞뒤 이동·준비 시간은 buffer 로 둔다. 결과의 conflicting_blocks 는 겹친 블록이므로 set_schedule 로 다시 배치한다.",
    "input_schema": {
      "type": "object",
      "properties": {
        "id": {"type": "integer"},
        "title": {"type": "string"},
        "start": {"type": "string"},
        "end": {"type": "string"},
        "buffer_before_min": {"type": "integer"},
        "buffer_after_min": {"type": "integer"},
        "sensitive": {"type": "boolean"},
        "confirm_text": {"type": "string", "description": "확인 카드가 될 때 사용자에게 보일 이유 한 문장"}
      }
    }
  },
  {
    "name": "upsert_note",
    "description": "실행 약속이 없는 막연한 생각을 메모로 저장하거나 상태를 바꾼다.",
    "input_schema": {
      "type": "object",
      "properties": {
        "id": {"type": "integer"},
        "content": {"type": "string"},
        "status": {"type": "string", "enum": ["open", "converted", "dismissed"]}
      }
    }
  },
  {
    "name": "cancel",
    "description": "목표·할 일·일정·메모를 취소한다. 연결된 미래 블록도 취소된다.",
    "input_schema": {
      "type": "object",
      "properties": {
        "entity": {"type": "string", "enum": ["goal", "task", "event", "note"]},
        "id": {"type": "integer"},
        "confirm_text": {"type": "string", "description": "확인 카드가 될 때 사용자에게 보일 이유 한 문장"}
      },
      "required": ["entity", "id"]
    }
  },
  {
    "name": "save_memory",
    "description": "사용자에 대한 지속적인 사실을 정리한 memory 전체를 교체한다. 기존 내용을 유지하면서 고쳐 쓴다.",
    "input_schema": {
      "type": "object",
      "properties": {"content": {"type": "string"}},
      "required": ["content"]
    }
  },
  {
    "name": "undo_last",
    "description": "사용자의 직전 요청으로 바뀐 것을 되돌린다(\"방금 거 취소\").",
    "input_schema": {"type": "object", "properties": {}}
  },
  {
    "name": "set_schedule",
    "description": "[from, to) 구간에서 시작하는 planned 블록을 모두 이 blocks 로 바꾼다. 검증에 실패하면 violations 를 돌려주고 아무것도 바꾸지 않는다.",
    "input_schema": {
      "type": "object",
      "properties": {
        "from": {"type": "string"},
        "to": {"type": "string"},
        "blocks": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "task_id": {"type": "integer"},
              "start": {"type": "string"},
              "end": {"type": "string"},
              "screen_text": {"type": "string", "description": "시작 화면 한 문장. 비우면 '지금 할 건 하나예요. {first_action}'"}
            },
            "required": ["task_id", "start", "end"]
          }
        }
      },
      "required": ["from", "to", "blocks"]
    }
  },
  {
    "name": "move_block",
    "description": "planned 또는 nudging 블록 하나를 옮긴다. new_end 를 생략하면 길이를 유지한다.",
    "input_schema": {
      "type": "object",
      "properties": {
        "block_id": {"type": "integer"},
        "new_start": {"type": "string"},
        "new_end": {"type": "string"}
      },
      "required": ["block_id", "new_start"]
    }
  },
  {
    "name": "send_message",
    "description": "사용자에게 메시지를 보낸다. 사용자 메시지에 대한 답은 kind=reply.",
    "input_schema": {
      "type": "object",
      "properties": {
        "text": {"type": "string"},
        "kind": {"type": "string", "enum": ["reply", "proactive"]},
        "importance": {"type": "string", "enum": ["low", "normal", "high"]}
      },
      "required": ["text"]
    }
  },
  {
    "name": "ask_user",
    "description": "답이 필요한 것을 묻는다. 가능하면 선택지 버튼(최대 4개)을 준다.",
    "input_schema": {
      "type": "object",
      "properties": {
        "text": {"type": "string"},
        "options": {"type": "array", "items": {"type": "string"}, "maxItems": 4}
      },
      "required": ["text"]
    }
  }
]
